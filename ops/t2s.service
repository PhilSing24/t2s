[Unit]
Description=t2s market data pipeline (TP, WDB, feed handlers in tmux session t2s)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=philippe
Group=philippe
WorkingDirectory=/home/philippe/t2s
# start.sh needs q, tmux and the T2S_* paths from the user's shell profile.
Environment=HOME=/home/philippe
Environment=PATH=/home/philippe/.kx/bin:/usr/local/bin:/usr/bin:/bin
Environment=T2S_HDB_DIR=/home/philippe/t2s/hdb
Environment=T2S_TMP_DIR=/home/philippe/t2s/tmp/
ExecStart=/home/philippe/t2s/start.sh --headless --markets spot,futures
ExecStop=/home/philippe/t2s/stop.sh
TimeoutStartSec=900
TimeoutStopSec=120
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
